---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import PublicationList from "../components/PublicationList.astro";
import { getCollection } from "astro:content";
import { getFeaturedPapers } from "../lib/papers";
import siteConfig from "../side.config";
import { Image } from "astro:assets";

const showHero = siteConfig.homeBlocks.hero.enabled;
const showShowcase = siteConfig.homeBlocks.showcase?.enabled ?? true;
const showPublications = siteConfig.homeBlocks.publications.enabled;
const showPosts = siteConfig.homeBlocks.posts.enabled;

const allProjects = showShowcase
  ? (await getCollection("projects", ({ data }) => !data.draft)).sort(
      (a, b) => a.data.order - b.data.order,
    )
  : [];
const featuredProject = allProjects.find((p) => p.data.featured) || allProjects[0];
const secondaryProject = allProjects.find((p) => p.id !== featuredProject?.id);

const recentPosts = showPosts
  ? (await getCollection("posts"))
      .filter((post) => !post.data.draft)
      .sort(
        (a, b) =>
          new Date(b.data.publishedAt).getTime() -
          new Date(a.data.publishedAt).getTime(),
      )
      .slice(0, 3)
  : [];
const primaryPost = recentPosts.find((post) => post.data.featured) ?? recentPosts[0];
const secondaryPosts = recentPosts.filter((post) => post.id !== primaryPost?.id);

const selectedPapers = showPublications ? getFeaturedPapers(3) : [];

const about = {
  name: siteConfig.author,
  bio: siteConfig.hero.subheadline,
  socialLinks: siteConfig.socialLinks,
};

// Get affiliations and research interests from config
const affiliations = siteConfig.affiliations || [];
const researchInterests = siteConfig.researchInterests || [];
const statusBadge = siteConfig.hero.statusBadge;
const headline = siteConfig.hero.headline || about.name;
---

<Layout
  title="Home"
  description={siteConfig.hero.subheadline}
  schemaType="ProfilePage"
>
  <div class="space-y-12 pb-2 sm:space-y-16 sm:pb-4">
    {showHero && (
      <section class="relative border-b border-paper-300/90 pb-9 pt-3 dark:border-ink-700 sm:pb-12 sm:pt-6">
      <div class="space-y-6">
        <div class="min-w-0">
          <h1 class="max-w-4xl font-heading text-[clamp(2.5rem,6vw,4.5rem)] font-semibold leading-[1] tracking-[-0.035em] text-ink-950 dark:text-paper-50">
            {about.name}
          </h1>

          {affiliations.length > 0 && (
            <div class="mt-4">
              <div class="space-y-1">
                {affiliations.map((aff) => (
                  <p class="text-base leading-7 text-ink-600 dark:text-paper-300">
                    {aff.role}
                    {aff.department && <span>, {aff.department}</span>}
                    {aff.url ? (
                      <>
                        <span> at </span>
                        <a
                          href={aff.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="font-semibold text-accent-700 underline decoration-accent-300 underline-offset-4 transition-colors hover:text-accent-900 dark:text-accent-300 dark:decoration-accent-700 dark:hover:text-accent-100"
                        >
                          {aff.institution}
                        </a>
                      </>
                    ) : (
                      <span> at {aff.institution}</span>
                    )}
                  </p>
                ))}
              </div>
            </div>
          )}
          {statusBadge && (
            <div class="mt-4 inline-flex items-center gap-1.5 rounded-md border border-accent-300/40 bg-accent-50/70 px-2.5 py-1 text-xs font-semibold text-accent-800 dark:border-accent-700/50 dark:bg-accent-950/40 dark:text-accent-200">
              <span class="h-1.5 w-1.5 rounded-full bg-accent-500 animate-pulse" aria-hidden="true" />
              <span>{statusBadge}</span>
            </div>
          )}
        </div>

        <div class="min-w-0">
          <p class="max-w-[38rem] font-heading text-[1.5rem] font-medium leading-[1.25] tracking-[-0.015em] text-ink-900 dark:text-paper-100 sm:text-[1.75rem]">
            {headline}
          </p>

		  <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
            {showShowcase && featuredProject && (
              <a href="#selected-projects" class="action-link px-0">
                Selected projects
                <span class="i-ph-arrow-down text-base" aria-hidden="true"></span>
              </a>
            )}
            {showPosts && recentPosts.length > 0 && (
              <a href="#latest-posts" class="action-link px-0">
                Latest posts
                <span class="i-ph-arrow-down text-base" aria-hidden="true"></span>
              </a>
            )}
            {about.socialLinks.map((link) => {
              const opensNewTab = /^https?:/i.test(link.href);
              return (
                <a
                  href={link.href}
                  target={opensNewTab ? "_blank" : undefined}
                  rel={opensNewTab ? "noopener noreferrer" : undefined}
                  class="action-link px-0"
                >
                  <span class={`${link.icon} text-base`} aria-hidden="true" />
                  <span>{link.label}</span>
                  {opensNewTab && <span class="sr-only"> opens in a new tab</span>}
                </a>
              );
            })}
          </div>

		  <p class="mt-5 max-w-[65ch] text-[1.0625rem] leading-7 text-ink-700 dark:text-paper-300">
			{about.bio}
		  </p>

          {researchInterests.length > 0 && (
            <div class="mt-6 border-t border-paper-300/80 pt-4 dark:border-ink-700/80" aria-label="Research interests">
              <span class="sr-only">Research interests:</span>
              <ul class="flex list-none flex-wrap gap-2 p-0 m-0">
                {researchInterests.map((interest) => (
                  <li class="meta-chip">
                    <span class="h-1 w-1 rounded-full bg-accent-500" aria-hidden="true"></span>
                    <span>{interest}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
      </section>
    )}

    {showShowcase && featuredProject && (
      <section class="content-section" aria-labelledby="selected-projects">
        <div class="mb-5 flex flex-col gap-3 border-b border-paper-300/90 pb-4 dark:border-ink-700 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 id="selected-projects" class="feature-section-heading">
              {siteConfig.homeBlocks.showcase?.title || "Selected projects"}
            </h2>
            {siteConfig.homeBlocks.showcase?.description && (
              <p class="mt-1 text-sm text-ink-600 dark:text-paper-300">
                {siteConfig.homeBlocks.showcase.description}
              </p>
            )}
          </div>
          <a href="/projects" class="action-link self-start px-0 sm:self-auto">
            <span>Explore all projects</span>
            <span class="i-mdi:arrow-right text-base" aria-hidden="true"></span>
          </a>
        </div>

        <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
          <article class="bento-card-hero group flex flex-col justify-between lg:col-span-2">
            <div>
              <div class="mb-3.5 flex flex-wrap items-center gap-x-2 gap-y-2">
                <span class="chip-accent shrink-0 whitespace-nowrap text-[11px]">
                  <span class="i-mdi:star text-xs" aria-hidden="true" />
                  Featured project
                </span>
                <span class:list={[featuredProject.data.status === "active" ? "chip-status-active" : "chip-status-past", "shrink-0 whitespace-nowrap"]}>
                  {featuredProject.data.status}
                </span>
                <span class="w-full font-mono text-xs tabular-nums text-ink-500 dark:text-paper-400 sm:ml-auto sm:w-auto">
                  {featuredProject.data.period}
                </span>
              </div>

              <div class:list={["grid gap-5 items-start", featuredProject.data.cover && "sm:grid-cols-[1fr_160px]"]}>
                <div class="space-y-2.5">
                  <h3 class="entry-title text-2xl font-semibold">
                    <a href={`/projects/${featuredProject.id}`} class="no-underline text-inherit hover:text-accent-700 dark:hover:text-accent-300 transition-colors">
                      {featuredProject.data.title}
                    </a>
                  </h3>
                  {featuredProject.data.subtitle && (
                    <p class="font-sans text-xs font-semibold text-accent-700 dark:text-accent-300">
                      {featuredProject.data.subtitle}
                    </p>
                  )}
                  <p class="entry-summary text-sm line-clamp-3 leading-relaxed">
                    {featuredProject.data.summary}
                  </p>
                </div>

                {featuredProject.data.cover && (
                  <div class="hidden sm:block overflow-hidden rounded-xl border border-paper-300/90 aspect-[4/3] bg-paper-100 dark:border-ink-700 dark:bg-ink-800 shadow-sm">
                    <Image
                      src={featuredProject.data.cover}
                      format="webp"
                      widths={[160, 320]}
                      sizes="160px"
                      alt={featuredProject.data.coverAlt || featuredProject.data.title}
                      width={featuredProject.data.cover.width}
                      height={featuredProject.data.cover.height}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-105"
                    />
                  </div>
                )}
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-paper-200/90 dark:border-ink-700/80 flex flex-wrap items-center justify-between gap-3 text-xs">
              <div class="flex flex-wrap items-center gap-1.5">
                {featuredProject.data.badges.slice(0, 3).map((t) => (
                  <span class="scholarly-pill">{t}</span>
                ))}
              </div>
              <a href={`/projects/${featuredProject.id}`} class="action-link text-xs font-semibold px-0">
                <span>View project</span>
                <span class="i-mdi:arrow-right text-sm transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></span>
              </a>
            </div>
          </article>

          {secondaryProject && (
            <article class="surface-card-hover group flex flex-col justify-between p-6">
              <div class="space-y-3">
                <div class="flex items-center justify-between text-xs">
                  <span class={secondaryProject.data.status === "active" ? "chip-status-active" : "chip-status-past"}>
                    {secondaryProject.data.status}
                  </span>
                  <span class="font-mono text-xs tabular-nums text-ink-500 dark:text-paper-400">
                    {secondaryProject.data.period}
                  </span>
                </div>

                <div class="space-y-1">
                  <h3 class="entry-title text-lg">
                    <a href={`/projects/${secondaryProject.id}`} class="no-underline text-inherit hover:text-accent-700 dark:hover:text-accent-300 transition-colors">
                      {secondaryProject.data.title}
                    </a>
                  </h3>
                  <p class="entry-summary text-xs line-clamp-4 leading-relaxed">
                    {secondaryProject.data.summary}
                  </p>
                </div>
              </div>

              <div class="mt-5 pt-4 border-t border-paper-200/90 dark:border-ink-700/80 flex items-center justify-between text-xs">
                {secondaryProject.data.badges[0] && (
                  <span class="scholarly-pill">{secondaryProject.data.badges[0]}</span>
                )}
                <a href={`/projects/${secondaryProject.id}`} class="action-link text-xs font-semibold px-0">
                  <span>Details</span>
                  <span class="i-mdi:arrow-right text-sm transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></span>
                </a>
              </div>
            </article>
          )}
        </div>
      </section>
    )}

    {showPosts && recentPosts.length > 0 && (
      <section class="content-section" aria-labelledby="latest-posts">
      <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 id="latest-posts" class="feature-section-heading">
            {siteConfig.homeBlocks.posts.title}
          </h2>
          {siteConfig.homeBlocks.posts.description && (
            <p class="mt-1 text-sm text-ink-600 dark:text-paper-300">{siteConfig.homeBlocks.posts.description}</p>
          )}
        </div>
        <a href="/posts" class="action-link self-start px-0 sm:self-auto">
          Visit the archive
          <span class="i-ph-arrow-right text-base" aria-hidden="true"></span>
        </a>
      </div>

      {primaryPost && (
        <div>
          <PostCard post={primaryPost} variant="featured" />
          {secondaryPosts.length > 0 && (
            <div class="mt-8 grid gap-8">
              {secondaryPosts.map((post) => <PostCard post={post} variant="featured" />)}
            </div>
          )}
        </div>
      )}
      </section>
    )}

    {showPublications && selectedPapers.length > 0 && (
      <section class="content-section" aria-labelledby="selected-publications">
      <div class="mb-4 flex flex-col gap-3 border-b border-paper-300/90 pb-4 dark:border-ink-700 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 id="selected-publications" class="feature-section-heading">
            {siteConfig.homeBlocks.publications.title}
          </h2>
          {siteConfig.homeBlocks.publications.description && (
            <p class="mt-1 text-sm text-ink-600 dark:text-paper-300">{siteConfig.homeBlocks.publications.description}</p>
          )}
        </div>
        <a href="/publications" class="action-link self-start px-0 sm:self-auto">
          Browse all publications
          <span class="i-ph-arrow-right text-base" aria-hidden="true"></span>
        </a>
      </div>

      <PublicationList papers={selectedPapers} />
      </section>
    )}
  </div>
</Layout>
